mat3 lpvSaturationMatrix(float s) {
   vec3 w = vec3(0.299, 0.587, 0.114) * (1.0 - s);

   return mat3(w.r + s, w.r,     w.r,
               w.g,     w.g + s, w.g,
               w.b,     w.b,     w.b + s);
}

vec3 lpvEmitRgb(int idx) {
   if (idx < 0 || idx >= LPV_LIGHT_COLOR.length()) {
      return vec3(0.0);
   }

   return lpvSaturationMatrix(LPV_SATURATION) * LPV_LIGHT_COLOR[idx];
}

vec3 lpvTintRgb(int idx) {
   if (idx < 0 || idx >= LPV_TINT_COLOR.length()) {
      return vec3(1.0);
   }

   return lpvSaturationMatrix(LPV_TINT_SATURATION) * LPV_TINT_COLOR[idx];
}

vec3 lpvLevelRgb(int level) {
   float t = clamp(float(level), 0.0, 15.0) * (13.0 / 15.0);
   return vec3(t);
}

